rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Catalog Products: Public can view, Admin can create/update/delete
    match /catalog_products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. Client Rental Bookings & Inquiries
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // 3. Newsletter & Subscriber lists
    match /newsletter/{subscriberId} {
      allow read: if true;
      allow create, write: if true;
    }

    // 4. Default rule
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
